# Copy to .env.local (npm run setup does this automatically).
#
# MINIMUM to run locally: AUTH_SECRET, AUTH_URL, NEXT_PUBLIC_API_URL,
# DATABASE_URL, FRONTEND_URL — see docs/LOGIN.md
#
# FOR AI: OPENROUTER_API_KEY — see docs/TESTING.md step 4
#
# ─── Frontend (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend (FastAPI) — also used by Alembic ─────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/learnflow
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Auth — NextAuth (frontend) + FastAPI (backend sessions in PostgreSQL)
# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth — set in Google Console; redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# AI (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email (https://resend.com)
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=LearnFlow <noreply@yourdomain.com>
CONTACT_TO_EMAIL=support@learnflow.app

# File uploads (https://uploadthing.com) — optional; note images use /api/notes/upload-attachment
UPLOADTHING_TOKEN=
# Legacy (v6) — converted to TOKEN automatically if TOKEN is unset:
UPLOADTHING_SECRET=sk_live_your-key
UPLOADTHING_APP_ID=your-app-id

# Cron (generate: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-here
