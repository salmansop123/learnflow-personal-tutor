
# ─── Frontend (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Backend (FastAPI) — also used by Alembic ─────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/learnflow
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Auth — NextAuth (frontend) + FastAPI (backend sessions in PostgreSQL)
# Generate: openssl rand -base64 32
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth — set in Google Console; redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# AI (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email (https://resend.com)
RESEND_API_KEY=re_your-key-here
EMAIL_FROM=LearnFlow <noreply@yourdomain.com>
CONTACT_TO_EMAIL=support@learnflow.app

# File uploads (https://uploadthing.com) — optional; note images use /api/notes/upload-attachment
UPLOADTHING_TOKEN=
# Legacy (v6) — converted to TOKEN automatically if TOKEN is unset:
UPLOADTHING_SECRET=sk_live_your-key
UPLOADTHING_APP_ID=your-app-id

# Cron (generate: openssl rand -base64 32)
CRON_SECRET=your-cron-secret-here

# Stripe (https://dashboard.stripe.com/apikeys)
# Publishable key — safe for the browser (Checkout / Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Secret key — server only; never expose to the client
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret — from Stripe Dashboard → Developers → Webhooks
# Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Price IDs — create Products/Prices in Stripe Dashboard (subscription, USD)
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_PRO_YEARLY=price_your-pro-yearly-id
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_your-premium-plus-monthly-id
STRIPE_PRICE_PREMIUM_PLUS_YEARLY=price_your-premium-plus-yearly-id
